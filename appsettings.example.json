{
  // ŞABLON — bu dosyaya gerçek bilgi YAZMAYIN (depoya gider).
  // Bu dosyayı "appsettings.json" adıyla kopyalayın ve bilgileri appsettings.json'a girin:
  //   cp appsettings.example.json appsettings.json
  // appsettings.json depoya GİRMEZ (.gitignore). Prod testleri ve kontrol aracı o dosyayı okur:
  //   dotnet test --filter Environment=Prod
  //   dotnet run --project tools/KpsV2.ProdCheck
  // "Kps" (Sağlık Bakanlığı KPS) ve "NviKps" (NVİ KPS) bölümleri, paketi kullanan bir projenin appsettings.json'ındaki
  // bölümlerle birebir aynıdır. Kullanmadığınız sistemin bölümünü şablondaki gibi bırakın; kontrol aracı onu atlar.
  // Test ortamı için bilgi girmeye gerek yoktur (herkese açık test kullanıcısı kodda hazır).
  "Kps": {
    "Environment": "Prod",
    "Username": "<sorgulayan kişinin TC kimlik no>",
    "Password": "<KPS web servis şifresi>",
    "InstitutionCode": "<kurum kodu>",
    "ApplicationCode": "<uygulama GUID>",
    // Uygulama kullanıcısıysanız InstitutionCode/ApplicationCode yerine:
    // "RequesterIdentityNumber": "<TC>",
    "RetryCount": 2
  },
  "NviKps": {
    // NVİ KPS (kpsbasvuru.nvi.gov.tr başvurusu): onay yazısında verilen web servis kullanıcı adı ve şifresi.
    "Username": "<NVİ web servis kullanıcı adı>",
    "Password": "<NVİ web servis şifresi>",
    "RetryCount": 2
  },
  "ProdCheck": {
    // Zorunlu: sorgulanmasına izniniz olan bir kimlik no (ör. kendi TC'niz).
    "IdentityNumber": 0
    // İsteğe bağlı (boşsa sorgu sonuçlarından alınır):
    // "BirthDate": "1980-03-15",
    // "AddressNumber": 1234567890,
    // "BlueCardIdentityNumber": 0,
    // "BlueCardBirthDate": "1980-01-01",
    // "ParameterName": "<ParametreAdListesi'ndeki bir ad>",
    // NVİ TCKimlikNoDogrula için (boşsa kişi sorgularından alınır):
    // "FirstName": "<ad>",
    // "LastName": "<soyad>"
  }
}
