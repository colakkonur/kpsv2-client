<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net7.0: .NET 7, 8, 9, 10... projelerinin hepsine eklenebilir. -->
    <TargetFramework>net7.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>KpsV2</RootNamespace>
    <!-- net7.0 destek dışı uyarısını bastır: hedef bilinçli olarak tüketici projelerle uyum için seçildi. -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- NuGet paketi -->
    <PackageId>KpsV2.Client</PackageId>
    <!-- Paket kodunu değiştiren PR bu sürümü artırır; main'e merge olunca bu sürüm otomatik olarak nuget.org'a yayınlanır. -->
    <Version>2.1.0</Version>
    <Authors>colakkonur</Authors>
    <Description>Sağlık Bakanlığı Kimlik Paylaşım Sistemi (KPS v2) ve NVİ Kimlik Paylaşımı Sistemi için resmî olmayan .NET istemcisi (Bakanlıklarla bağlantısı yoktur; kullanmak için kendi KPS hesabınız gerekir). Sağlık KPS: Kps servisinin 16 ve Parametre servisinin 2 metodu; NVİ KPS: TC kimlik no doğrulama ve kişi sorgulama. WSDL'den üretilmiş tipli istek/cevaplar. STS token önbelleği, geçici hatalarda yeniden deneme, hata sınıflandırması ve ASP.NET Core DI desteği içerir.</Description>
    <PackageTags>kps;kpsv2;saglik;nvi;kimlik;mernis;soap</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/colakkonur/kpsv2-client</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/colakkonur/kpsv2-client</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <!-- NuGet README: tek kaynak docs/kullanim.md -->
    <None Include="..\..\docs\kullanim.md" Pack="true" PackagePath="\README.md" Link="docs\kullanim.md" />
  </ItemGroup>

  <ItemGroup>
    <!-- En düşük sürümler: tüketici projedeki daha yeni sürümler otomatik seçilir. -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="7.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KpsV2.Client.Tests" />
  </ItemGroup>

</Project>
